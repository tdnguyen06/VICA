# =================================================================
# Vietnam Cultural Atlas - Root Environment Configuration (.env)
# =================================================================

# -----------------
# Application Ports
# -----------------
SERVER_PORT=8080
FRONTEND_PORT=5173
SPRING_PROFILES_ACTIVE=dev

# -----------------
# Database (PostgreSQL + PostGIS + pgvector)
# -----------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vietnam_cultural_atlas
DB_USERNAME=postgres
DB_PASSWORD=postgres

# -----------------
# Redis Cache
# -----------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------
# RabbitMQ Message Broker
# -----------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# -----------------
# Security & JWT
# -----------------
JWT_SECRET=culturalAtlasSecretKeyForDevelopmentPhaseMustBeAtLeast32BytesLong!
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------
# AI & LLM Provider (gemini or openai)
# -----------------
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_CHAT_MODEL=gemini-1.5-flash
AI_EMBEDDING_MODEL=text-embedding-004
AI_ENABLED=false
AI_TOP_K=5
AI_SIMILARITY_THRESHOLD=0.75

# -----------------
# AWS S3 Storage (Data Scripts, Datasets & Media Assets)
# -----------------
AWS_PROFILE=default
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your_s3_bucket_name_here
DATALAKE_BUCKET=your_s3_bucket_name_here

# -----------------
# Cloudinary (Media Assets)
# -----------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------
# Map Tiles & GIS
# -----------------
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

