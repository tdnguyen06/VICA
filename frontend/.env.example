# Vietnam Cultural Atlas - Frontend Environment Variables
VITE_APP_TITLE="Vietnam Cultural Atlas"
VITE_API_BASE_URL="http://localhost:8080/api/v1"
# RAG server origin; separate from VITE_API_BASE_URL and without /rag or /api/v1.
# Example: http://<EC2_PUBLIC_IP> for local testing, https://rag.example.com in production.
# Set the actual value in .env.local for local development or in the production build environment.
# VITE_RAG_BASE_URL=

# Map Tiles / MapLibre Style URL
# Example options: Carto Positron, MapTiler, OpenStreetMap
VITE_MAP_STYLE_URL="https://basemaps.cartocdn.com/gl/positron-gl-style/style.json"

