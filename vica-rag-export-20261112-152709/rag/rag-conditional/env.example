# cp .env.example .env && chmod 600 .env   then edit. Never commit .env.
POSTGRES_DB=ragdb
POSTGRES_USER=rag
POSTGRES_PASSWORD=

# OpenAI API key. Store the real value in .env on EC2; do not commit it.
OPENAI_API_KEY=

OPENAI_CHAT_MODEL=gpt-4o-mini
# Dimension is fixed at 768 in application.yml; text-embedding-3-small supports this dimension.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: only the web-search route needs it
TAVILY_SEARCH_API_KEY=

# ":80" = HTTP on the IP. A hostname = automatic HTTPS.
SITE_ADDRESS=:80

# Origin(s) of your web frontend, comma-separated, no trailing slash
CORS_ALLOWED_ORIGINS=http://localhost:5173
