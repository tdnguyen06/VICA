# cp .env.example .env && chmod 600 .env   then edit. Never commit .env.
POSTGRES_DB=ragdb
POSTGRES_USER=rag
POSTGRES_PASSWORD=

# Key from https://aistudio.google.com/apikey (Gemini Developer API)
GEMINI_API_KEY=

# gemini-2.5-flash-lite is not deprecated. gemini-2.5-flash is announced to retire on 2026-12-01.
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# Dimension is fixed at 768 in application.yml. If you change it, wipe the pgdata volume.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: only the web-search route needs it
TAVILY_SEARCH_API_KEY=

# ":80" = HTTP on the IP. A hostname = automatic HTTPS.
SITE_ADDRESS=:80

# Origin(s) of your web frontend, comma-separated, no trailing slash
CORS_ALLOWED_ORIGINS=http://localhost:3000
