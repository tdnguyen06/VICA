# =======================================================
# Vietnam Cultural Atlas - Backend Environment Variables
# =======================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL with PostGIS & pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vietnam_cultural_atlas
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# JWT Security
JWT_SECRET=culturalAtlasSecretKeyForDevelopmentPhaseMustBeAtLeast32BytesLong!
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
DEV_ADMIN_PASSWORD=
DEV_RESEARCHER_PASSWORD=
GOOGLE_CLIENT_ID=
MAIL_ENABLED=false
MAIL_FROM=no-reply@vica.local

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI & LLM Provider Configuration (gemini or openai)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_CHAT_MODEL=gemini-2.5-flash-lite
AI_EMBEDDING_MODEL=text-embedding-004
AI_ENABLED=false

# Cloudinary (Media Assets)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

